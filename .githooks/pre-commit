#!/usr/bin/env bash
# ==============================================================================
# DevSecOps Shift-Left Pre-Commit Hook: Secret Detection
# ==============================================================================
set -e

echo "🔒 [DevSecOps] Inspecting staged changes for credentials and secrets..."

# Detect Gitleaks (native binary or Docker container fallback)
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks protect --staged --verbose --config .gitleaks.toml
elif command -v docker >/dev/null 2>&1; then
    docker run --rm -v "$(pwd):/path" -w /path zricethezav/gitleaks:latest protect --staged --verbose --config .gitleaks.toml
else
    echo "⚠️  [Warning] Neither 'gitleaks' nor 'docker' is installed. Skipping secret scanning."
    exit 0
fi

if [ $? -eq 0 ]; then
    echo "✅ [DevSecOps] Secret scan passed. No exposed credentials detected."
fi
