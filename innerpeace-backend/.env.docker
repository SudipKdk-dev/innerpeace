# Database (Docker container network)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=innerpeace_db
NODE_ENV=production
DB_SSL=false
DB_SYNCHRONIZE=true

# Server Configuration
PORT=3000

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost:8080,http://localhost:8081,http://127.0.0.1:5173,http://127.0.0.1:8080,http://127.0.0.1:8081

# JWT Authentication
JWT_SECRET=change_this_to_a_secure_jwt_secret
JWT_EXPIRES_IN=7d

# Email Service
FRONTEND_URL=http://localhost:8081
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="InnerPeace <noreply@innerpeace.local>"

# AWS S3 Storage
AWS_BUCKET=your_bucket_name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_PUBLIC_BASE_URL=https://your_bucket_name.s3.us-east-1.amazonaws.com
